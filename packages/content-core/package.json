{
  "name": "@lubook/content-core",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "manifest/路由快照/校验（Node/TS，单一内容清单；P1 接管 P0 tools/freeze_manifest.py）",
  "exports": {
    ".": "./src/index.ts"
  },
  "types": "./src/index.ts",
  "bin": {
    "book-manifest": "./src/cli.ts"
  },
  "scripts": {
    "manifest": "node src/cli.ts --appId hardware --src ../../apps/hardware/docs --out ../../.generated/hardware-content-manifest.ts.json --catalogOut ../../apps/hardware/docs/.vitepress/catalog.generated.mjs",
    "parity": "node src/parity.ts --app hardware"
  }
}
