# 参考资料原文（体积大，仅本地缓存，不入库）
sources/
sources/**

# 构建产物
dist/
dist/**

# 截图/自检临时目录
_shots/
**/_shots/
.shots/

# 自动修复前的本地备份（不入库）
_backup/
**/_backup/

# Python
__pycache__/
*.pyc
.venv/

# 系统/编辑器
.DS_Store
Thumbs.db
desktop.ini

# 临时排查/诊断脚本（下划线前缀，不入库）
tools/_*.py
packages/tooling/src/_*.py

# Node / VitePress
node_modules/

# VitePress 缓存与构建产物（仅忽略产物，config/theme/components 等源码需入库）
docs/.vitepress/cache/
docs/.vitepress/dist/
# 任意深度（templates/site-template、apps/handbook 等）
**/.vitepress/cache/
**/.vitepress/dist/

# 由 tools/build_vp_sidebar.py 自动生成（侧边栏、品牌 public 同步）；
# predocs:dev / predocs:build 会重新生成，源在 docs/.vitepress/theme/public 与 docs/SUMMARY.md
docs/.vitepress/sidebar.generated.mjs
docs/public/

# Monorepo 重构 P0 起的生成物（由 tools/freeze_manifest.py 生成，不入库；快照在 tests/ 入库）
.generated/

# 多 app 合并部署目录（build_pages_bundle.py 产出）；本地预览根（不入库）
.bundle/
.bundle_test/
.preview_root/

# P2 起：apps/templates 内 VitePress 生成的侧边栏/目录模块与同步的 public（不入库）
**/.vitepress/sidebar.generated.mjs
**/.vitepress/catalog.generated.mjs
**/docs/public/
**/docs/.vitepress/theme/public/
