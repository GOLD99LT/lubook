{
  "name": "lubook-monorepo",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "路书 Lubook · pnpm Monorepo（门户 + 多分册在线 VitePress + 离线单文件，共享内容内核）",
  "packageManager": "pnpm@12.11.2",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "gen:portal": "pnpm -F @lubook/portal gen:public",
    "dev:portal": "pnpm -F @lubook/portal docs:dev",
    "build:portal": "pnpm -F @lubook/portal docs:build",
    "preview:portal": "pnpm -F @lubook/portal docs:preview",
    "gen:hardware": "pnpm -F @lubook/hardware gen",
    "dev:hardware": "pnpm -F @lubook/hardware docs:dev",
    "build:hardware": "pnpm -F @lubook/hardware docs:build",
    "preview:hardware": "pnpm -F @lubook/hardware docs:preview",
    "quality:hardware": "python run_quality.py --app hardware",
    "freeze:hardware": "python packages/tooling/src/freeze_manifest.py --app hardware --accept",
    "offline:hardware": "pnpm run freeze:hardware && python packages/tooling/src/build_single_html.py --app hardware --manifest .generated/hardware-content-manifest.json",
    "build:template": "pnpm -F @lubook/site-template docs:build",
    "manifest": "pnpm -F @lubook/content-core manifest",
    "manifest:parity": "pnpm -F @lubook/content-core parity",
    "test:learning": "node packages/learning/test/learning.test.ts",
    "verify:all": "python packages/tooling/src/verify_all.py",
    "check:sources": "python packages/tooling/src/check_sources_online.py",
    "check:sources:selftest": "python packages/tooling/src/check_sources_online.py --self-test",
    "bundle": "python packages/tooling/src/build_pages_bundle.py",
    "bundle:pages": "python packages/tooling/src/build_pages_bundle.py --vp-base /lubook/",
    "bundle:cloudflare": "python packages/tooling/src/build_pages_bundle.py --vp-base /",
    "dev:embedded": "pnpm -F @lubook/embedded docs:dev",
    "build:embedded": "pnpm -F @lubook/embedded docs:build",
    "preview:embedded": "pnpm -F @lubook/embedded docs:preview",
    "gen:embedded": "pnpm -F @lubook/embedded gen",
    "quality:embedded": "python run_quality.py --app embedded",
    "freeze:embedded": "python packages/tooling/src/freeze_manifest.py --app embedded --accept",
    "offline:embedded": "pnpm run freeze:embedded && python packages/tooling/src/build_single_html.py --app embedded --manifest .generated/embedded-content-manifest.json",
    "dev:embedded-linux": "pnpm -F @lubook/embedded-linux docs:dev",
    "build:embedded-linux": "pnpm -F @lubook/embedded-linux docs:build",
    "preview:embedded-linux": "pnpm -F @lubook/embedded-linux docs:preview",
    "gen:embedded-linux": "pnpm -F @lubook/embedded-linux gen",
    "quality:embedded-linux": "python run_quality.py --app embedded-linux",
    "freeze:embedded-linux": "python packages/tooling/src/freeze_manifest.py --app embedded-linux --accept",
    "offline:embedded-linux": "pnpm run freeze:embedded-linux && python packages/tooling/src/build_single_html.py --app embedded-linux --manifest .generated/embedded-linux-content-manifest.json"
  },
  "devDependencies": {
    "wrangler": "^4.151.3"
  }
}
